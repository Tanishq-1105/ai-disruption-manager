PORT=4000

# Sabre REST (client credentials grant). Cert base URL shown; swap to production host at go-live.
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=
SABRE_BASE_URL=https://api-crt.cert.havail.sabre.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Requires a local mongod running (or point at a remote cluster).
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=travel_disruption_concierge
