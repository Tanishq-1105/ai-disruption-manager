PORT=4001

# Sabre REST (client credentials grant). Cert base URL shown; swap to production host at go-live.
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=
SABRE_BASE_URL=https://api-crt.cert.havail.sabre.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Requires a local mongod running (or point at a remote cluster).
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=travel_disruption_concierge

# ---------------------------------------------------------------------------
# Optional providers. Each fills a gap this Sabre account cannot: it has no
# flight-status feed, no seat map, and no bookable ticketing. Leave blank and
# the app falls back to the simulator - nothing breaks.
#
# Verify any key you add BEFORE trusting it:
#   npm run probe:providers
# ---------------------------------------------------------------------------

# Duffel - free instant sandbox at https://app.duffel.com/join
# Used for: real sandbox bookings, order changes, and seat maps.
# The test token starts with "duffel_test_". Never paste a live token here.
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com

# AeroDataBox via RapidAPI - free tier at https://rapidapi.com/aedbx-aedbx/api/aerodatabox
# Used for: live flight status, so the Phase 2 Watcher can poll something real.
RAPIDAPI_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com

# OpenSky Network - live aircraft positions. Anonymous access needs NO key;
# credentials only raise the rate limit. https://opensky-network.org
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Which provider answers getFlightStatus(). "simulator" keeps the demo
# self-contained and is the right default for a live demo.
STATUS_PROVIDER=simulator

# Which provider performs bookings. "simulator" is the only safe default;
# "duffel" books real sandbox orders once DUFFEL_ACCESS_TOKEN is set.
BOOKING_PROVIDER=duffel

# Which provider answers flight search. "duffel" covers every route tested;
# "sabre" only has data for JFK-LAX on this CERT account.
SEARCH_PROVIDER=duffel

# Autonomy limit. Currency MUST match what the search provider quotes
# (Duffel test mode quotes EUR; Sabre CERT quotes USD).
POLICY_COST_CAP_AMOUNT=300
POLICY_COST_CAP_CURRENCY=EUR
