# localhost won't reach the dev machine from a physical device — use your
# machine's LAN IP instead, with your phone on the same Wi-Fi network.
# Find it with: ipconfig (Windows) / ifconfig or ip addr (macOS/Linux)
EXPO_PUBLIC_API_BASE_URL=http://<your-LAN-IP>:4001

# Optional: set when Metro must advertise a specific LAN host to the phone.
# A physical device cannot reach the dev machine on localhost.
#EXPO_PACKAGER_HOSTNAME=<computer-LAN-IP>
